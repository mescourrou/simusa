@startuml
skinparam pageMargin 10
skinparam linetype polyline
skinparam linetype ortho
skinparam groupImplementation 2

package simulator {
    class Simulator {
        {static} from_config(SimulatorConfig, plugin_api: Option<PluginAPI>) -> Simulator
        load_config(SimulatorConfig, plugin_api: Option<PluginAPI>)
        reset(plugin_api: Option<PluginAPI>)
        set_max_time(f32)
        run()
        load_results(filename: Option<String>) -> f32
        {static} deserialize_results_from_file(filename: Path) -> Results
        compute_results()
        ===
        get_records(sorted: bool = false) -> [Record]
        get_async_api() -> SimulatorAsyncApi
        get_broker() -> Broker
        get_context() -> Context
        get_environment() -> Environment
        get_nodes() -> [Node]
    }
    Simulator *-- "*" .node.Node
    Simulator *-- .utils.DeterministRandomVariableFactory
    Simulator -- "?" .PluginAPI
    Simulator -- SimulatorAsyncApi

    class AsyncSimulator {
        {static} from_config(SimulatorConfig, plugin_api: Option<PluginAPI>) -> AsyncSimulator
        run(plugin_api: Option<PluginAPI>, max_time: Option<f32>, reset: bool)
        get_records(sorted: bool = false) -> [Record]
        compute_results()
        stop()
        get_simulator() -> Simulator
    }
    AsyncSimulator *-- .api.AsyncApiRunner
    AsyncSimulator *-- .api.AsyncApi
    AsyncSimulator *-- "?" .api.PluginAsyncAPI

    class SimulatorAsyncApi {
        current_time: f32
        {field} records: mpsc::Receiver<Record>
    }

}

package api {
    class AsyncApiRunner {
        new_with_simulator(Simulator) -> AsyncApiRunner
        get_api() -> AsyncApi
        get_simulator() -> Simulator
        stop()
        run(plugin_api: Option<PluginAPI>)
    }
    AsyncApiRunner -- AsyncApi
    AsyncApiRunner *-- AsyncApiServer
    AsyncApiRunner *-- Simulator

    note top of api.AsyncApi
    The Async api of the simulator
    use mpsc channels to communicate
    between clients and simulator
    end note
    class AsyncApi {
        simulator_api() -> SimulatorAsyncApi
        load_config(SimulatorConfig, force_send_results: bool) -> SimulatorConfig
        load_results(filename: Option<String>) -> f32
        run(max_time: Option<f32>, reset: bool)
        get_records(sorted: bool) -> [Record]
        compute_results()
    }

    class PluginAsyncAPI {
        get_client() -> PluginAsyncAPIClient
    }
    PluginAPI <|-- PluginAsyncAPI
    PluginAsyncAPI -- PluginAsyncAPIClient

    class PluginAsyncAPIClient {
        get_state_estimator(PluginAsyncAPIRequest) -> StateEstimator
        get_navigator(PluginAsyncAPIRequest) -> Navigator
        get_controller(PluginAsyncAPIRequest) -> Controller
        get_physics(PluginAsyncAPIRequest) -> Physics
    }
    PluginAsyncAPIClient -- PluginAsyncAPIRequest

    class PluginAsyncAPIRequest {
        {field} config: crate::utils::GeneralValue
        global_config: SimulatorConfig
        va_factory: DeterministRandomVariableFactory
        network: Network
        initial_time: f32
    }

}

package node {
    enum NodeType {
        Robot
        Sensor
        Object
        ComputationUnit
    }
    ' note right of NodeType::Robot
    '     Can move, can be detected, can sense, can communicate
    ' end note
    ' note right of NodeType::Sensor
    '     Cannot move, cannot be detected, can sense, can communicate
    ' end note
    ' note right of NodeType::Object
    '     Can be moved, can be detected, cannot sense, cannot communicate
    ' end note
    ' note right of NodeType::ComputationUnit
    '     Cannot move, cannot be detected, cannot sense, can communicate
    ' end note
    class Node {
        next_time_step(min_time_excluded: f32) -> f32
        name() -> String
        state() -> NodeState
        send_records() -> bool
        other_node_names() -> [String]
        node_type() -> NodeType
        network() -> Network
        physics() -> Physics
        sensor_manager() -> SensorManager
        state_estimator() -> StateEstimator
        state_estimator_bench() -> [BenchStateEstimator]
        navigator() -> Navigator
        controller() -> Controller
        environment() -> Environment
        get_other_node_physics(node_name: String) -> Option<Physics>
        get_all_node_physics() -> dict(String, Physics)
        meta_data() -> NodeMetaData
        meta_data_list() -> dict(String, NodeMetaData)
        pre_kill()
    }
    Node *-- NodeType

    class NodeFactory {
        make_robot(RobotConfig) -> Node
        make_sensor(SensorConfig) -> Node
        make_object(ObjectConfig) -> Node
        make_computation_unit(ComputationUnitConfig) -> Node
    }
    NodeFactory --> Node

    class NodeMetaData {
        name: String
        node_type: NodeType
        model_name: String
        labels: [String]
        state: NodeState
        position: Option<(f32, f32)>
    }
    NodeMetaData *-- NodeType
    NodeMetaData *-- NodeState

    enum NodeState {
        Created
        Running
        Zombie
        Terminated
    }
}

package physics {
    node.Node *-- "+" Physics
    interface Physics {
        post_init(Node)
        apply_command(Command, time: f32)
        update_state(time: f32)
        state(time: f32) -> State
        next_time_step() -> Option<f32>
    }
    note left of Physics: Allow to be mobile\nand to be perceived

    class PerfectPhysics
    Physics <|.. PerfectPhysics
    class PluginPhysics
    Physics <|.. PluginPhysics
    PluginPhysics *-- Physics
    class PythonPhysics
    Physics <|.. PythonPhysics

    package fault_models {
        interface PhysicsFaultModel {
            post_init(Node)
            add_faults(time: f32, state: mut State)
        }
        class AdditiveRobotCenteredPhysicsFault
        PhysicsFaultModel <|.. AdditiveRobotCenteredPhysicsFault
        class PythonPhysicsFaultModel
        PhysicsFaultModel <|.. PythonPhysicsFaultModel
    }

    package robot_model {
        interface RobotModel {
            update_state(previous_state: mut State, command: Command, dt: f32)
            default_command() -> Command
        }
        class HolonomicCommand {
            longitudinal_velocity: f32
            lateral_velocity: f32
            angular_velocity: f32
        }
        class Holonomic
        RobotModel <|.. Holonomic
        HolonomicCommand -- Holonomic

        class UnicycleCommand {
            left_wheel_velocity: f32
            right_wheel_velocity: f32
        }
        class Unicycle
        RobotModel <|.. Unicycle
        UnicycleCommand -- Unicycle

        enum Command {
            Unicycle(UnicycleCommand)
            Holonomic(HolonomicCommand)
        }
        Command::Unicycle --> UnicycleCommand
        Command::Holonomic --> HolonomicCommand
    }
    PerfectPhysics *-- RobotModel
    PerfectPhysics *-- "*" PhysicsFaultModel

}

package state_estimators {
    node.Node *-- "+" StateEstimator
    interface StateEstimator {
        post_init(Node)
        prediction_step(Node, Option<Command>, time: f32)
        correction_step(Node, [Observation], time: f32)
        world_state() -> WorldState
        next_time_step() -> f32
        pre_loop_hook(Node, time: f32)
    }

    class WorldState {
        +{field} ego: Option<State>
        +{field} objects: dict(String, State)
        +{field} landmarks: dict(i32, State)
        +{field} occupancy_grid: Option<OccupancyGrid>
    }

    WorldState *-- "*" State

    class State {
        +{field} pose: (f32, f32, f32)
        +{field} velocity: (f32, f32, f32)
    }
    StateEstimator -- WorldState
    StateEstimator -- .physics.robot_model.Command
    StateEstimator -- .sensors.Observation


    class PerfectEstimator
    StateEstimator <|.. PerfectEstimator
    class PluginEstimator
    StateEstimator <|.. PluginEstimator
    PluginEstimator *-- StateEstimator
    class PythonEstimator
    StateEstimator <|.. PythonEstimator
}

package environment {
    class Environment {
        map: Map
        {field} meta_data_list: dict(String, NodeMetaData)
        get_observable_landmarks(position, observer_height, max_distance) -> [OrientedLandmark]
        is_target_observable(target_position, target_height, observer_position, observer_height, max_distance) -> bool
    }
    Environment *-- Map
    Environment -- "*" NodeMetaData

    class Map {
        landmarks: [OrientedLandmark]
    }
    Map *-- "*" OrientedLandmark

    class OrientedLandmark {
        id: i32
        labels: [String]
        pose: (f32, f32, f32)
        height: f32
        width: f32
    }
    .simulator.Simulator *-- Environment
}


package navigators {
    node.Node *-- "+" Navigator
    interface Navigator {
        post_init(Node)
        compute_error(Node, WorldState) -> ControllerError
        pre_loop_hook(Node, time: f32)
        next_time_step() -> Option<f32>
    }
    Navigator -- .controllers.ControllerError
    Navigator -- .state_estimators.WorldState

    class TrajectoryFollower
    Navigator <|.. TrajectoryFollower
    class GoTo
    Navigator <|.. GoTo
    class PluginNavigator
    Navigator <|.. PluginNavigator
    PluginNavigator *-- Navigator
    class PythonNavigator
    Navigator <|.. PythonNavigator
}

package controllers {
    node.Node *-- "+" Controller
    interface Controller {
        post_init(Node)
        make_command(Node, ControllerError, time: f32) -> Command
        pre_loop_hook(Node, time: f32)
        next_time_step() -> Option<f32>
    }
    Controller -- .physics.robot_model.Command
    Controller -- ControllerError

    class ControllerError {
        lateral: f32
        longitudinal: f32
        theta: f32
        velocity: f32
    }

    class PID
    Controller <|.. PID
    class PluginController
    Controller <|.. PluginController
    PluginController *-- Controller
    class PythonController
    Controller <|.. PythonController
}


package utils {
    class DeterministRandomVariableFactory

    DeterministRandomVariableFactory --> DeterministRandomVariable
    interface DeterministRandomVariable

    package distributions {

        DeterministRandomVariable <|.. Bernouilli
        class Bernouilli

        DeterministRandomVariable <|.. Exponential
        class Exponential

        DeterministRandomVariable <|.. Normal
        class Normal

        DeterministRandomVariable <|.. Poisson
        class Poisson

        DeterministRandomVariable <|.. Uniform
        class Uniform

        DeterministRandomVariable <|.. Fixed
        class Fixed
    }

    class Frame {
        new(x: f32, y: f32, theta: f32) -> Frame
        transform() -> Isometry2
        attach_to_state(state: State) -> AttachedFrame
    }

    Frame -- AttachedFrame

    class AttachedFrame {
        state() -> State
        transform() -> Isometry2
        transform_point_frame_to_global(point: (f32, f32)) -> (f32, f32)
        transform_point_global_to_frame(point: (f32, f32)) -> (f32, f32)
    }
}

package sensors {
    node.Node *-- "+" SensorManager
    class SensorManager

    SensorManager *-- "*" Sensor
    interface Sensor {
        post_init(Node, initial_time: f32)
        get_observations(Node, time: f32) -> [Observation]
        next_time_step() -> Option<f32>
    }
    Sensor -- Observation

    Sensor <|.. GNSSSensor
    class GNSSSensor

    class GNSSObservation {
        +{field} pose: (f32, f32, f32)
        +{field} velocity: (f32, f32)
        +{field} applied_faults
        +{field} frame
    }
    GNSSSensor -- GNSSObservation
    GNSSObservation *-- .utils.Frame

    Sensor <|.. SpeedSensor
    class SpeedSensor

    class SpeedObservation {
        +{field} linear_velocity: f32
        +{field} lateral_velocity: f32
        +{field} angular_velocity: f32
        +{field} applied_faults
        +{field} frame
    }
    SpeedSensor -- SpeedObservation
    SpeedObservation *-- .utils.Frame

    Sensor <|.. DisplacementSensor
    class DisplacementSensor

    class DisplacementObservation {
        +{field} translation: (f32, f32)
        +{field} rotation: f32
        +{field} applied_faults
        +{field} frame
    }
    DisplacementSensor -- DisplacementObservation
    DisplacementObservation *-- .utils.Frame

    Sensor <|.. OrientedLandmarkSensor
    class OrientedLandmarkSensor

    class OrientedLandmarkObservation {
        +{field} id: i32
        +{field} labels: [String]
        +{field} pose: (f32, f32, f32)
        +{field} height: f32
        +{field} width: f32
        +{field} applied_faults
        +{field} frame
    }
    OrientedLandmarkSensor -- OrientedLandmarkObservation
    OrientedLandmarkObservation *-- .utils.Frame

    Sensor <|.. RobotSensor
    class RobotSensor

    class OrientedRobotObservation {
        +{field} name: String
        +{field} labels: [String]
        +{field} pose: (f32, f32, f32)
        +{field} applied_faults
        +{field} frame
    }
    OrientedRobotObservation -- RobotSensor
    OrientedRobotObservation *-- .utils.Frame

    Sensor <|.. ScanSensor
    class ScanSensor
    class ScanObservation {
        +{field} distances: [f32]
        +{field} angles: [f32]
        +{field} radial_velocities: [f32]
        +{field} applied_faults
        +{field} frame
    }
    ScanSensor -- ScanObservation
    ScanObservation *-- .utils.Frame

    Sensor <|.. PluginSensor
    PluginSensor *-- Sensor
    class PluginSensor
    class PluginObservation {
        +{field} observation: crate::utils::GeneralValue
    }

    class Observation {
        +sensor_name: String
        +observer: String
        +time: f32
        +sensor_observation: SensorObservation
    }
    Observation *-- SensorObservation

    enum SensorObservations {
        GNSS(GNSSObservation)
        Speed(SpeedObservation)
        Displacement(DisplacementObservation)
        OrientedLandmark(OrientedLandmarkObservation)
        OrientedRobot(OrientedRobotObservation)
        Scan(ScanObservation)
        Plugin(PluginObservation)
    }
    SensorObservations::GNSS --> GNSSObservation
    SensorObservations::Speed --> SpeedObservation
    SensorObservations::Displacement --> DisplacementObservation
    SensorObservations::OrientedLandmark --> OrientedLandmarkObservation
    SensorObservations::OrientedRobot --> OrientedRobotObservation
    SensorObservations::Scan --> ScanObservation
    SensorObservations::Plugin --> PluginObservation

    package fault_models {

        GNSSSensor *-- "*" FaultModel
        SpeedSensor *-- "*" FaultModel
        DisplacementSensor *-- "*" FaultModel
        OrientedLandmarkSensor *-- "*" FaultModel
        RobotSensor *-- "*" FaultModel
        ScanSensor *-- "*" FaultModel

        interface FaultModel {
            post_init(Node, initial_time: f32)
            add_faults(time: f32, seed: f32, observations: mut [SensorObservations], environment: Environment)
        }
        FaultModel -- .sensors.SensorObservations
        FaultModel -- .environment.Environment

        FaultModel <|.. Additive
        class Additive<SensorVariables> {
            apparition: Bernouilli
            distributions: "*" DeterministRandomVariable
            proportional_to: SensorVariable
            proportional_factor: f32
        }
        Additive::apparition *-- Bernouilli
        Additive::distributions *-- "*" DeterministRandomVariable

        FaultModel <|.. Clutter
        class Clutter<SensorVariables> {
            apparition: "*" DeterministRandomVariable
            distributions: "*" DeterministRandomVariable
            observation_id: String
        }
        Clutter::apparition *-- DeterministRandomVariable
        Clutter::distributions *-- "*" DeterministRandomVariable

        FaultModel <|.. Misassociation
        class Misassociation {
            apparition: Bernouilli
            distribution: DeterministRandomVariable
        }
        Misassociation::apparition *-- Bernouilli
        Misassociation::distribution *-- DeterministRandomVariable

        FaultModel <|.. Misdetection
        class Misdetection {
            apparition: Bernouilli
        }
        Misdetection::apparition *-- Bernouilli

        FaultModel <|.. PluginFault
        PluginFault *-- FaultModel
        class PluginFault

        FaultModel <|.. PythonFaultModel
        class PythonFaultModel
    }

    package sensor_filters {
        interface SensorFilter {
            post_init(Node)
            filter(time: f32, observations: mut SensorObservations) -> Option(SensorObservations)
        }
        SensorFilter -- .sensors.SensorObservations

        class RangeFilter<SensorVariables> {
            min_range: list(f32)
            max_range: list(f32)
            inside: bool
        }

        class PluginFilter
        SensorFilter <|.. PluginFilter
        PluginFilter *-- SensorFilter
        class PythonFilter
    }

    enum DisplacementSensorFilterType {
        Range(RangeFilter)
        Python(PythonFilter)
        Plugin(PluginFilter)
    }
    DisplacementSensorFilterType::Range --> sensor_filters.RangeFilter
    DisplacementSensorFilterType::Python --> sensor_filters.PythonFilter
    DisplacementSensorFilterType::Plugin --> sensor_filters.PluginFilter
    DisplacementSensor *-- DisplacementSensorFilterType

    enum GNSSSensorFilterType {
        Range(RangeFilter)
        Python(PythonFilter)
        Plugin(PluginFilter)
    }
    GNSSSensorFilterType::Range --> sensor_filters.RangeFilter
    GNSSSensorFilterType::Python --> sensor_filters.PythonFilter
    GNSSSensorFilterType::Plugin --> sensor_filters.PluginFilter
    GNSSSensor *-- GNSSSensorFilterType

    enum OrientedLandmarkSensorFilterType {
        Range(RangeFilter)
        Id(StringFilter)
        Label(StringFilter)
        Python(PythonFilter)
        Plugin(PluginFilter)
    }
    OrientedLandmarkSensorFilterType::Range --> sensor_filters.RangeFilter
    OrientedLandmarkSensorFilterType::Python --> sensor_filters.PythonFilter
    OrientedLandmarkSensorFilterType::Plugin --> sensor_filters.PluginFilter
    OrientedLandmarkSensorFilterType::Id --> sensor_filters.StringFilter
    OrientedLandmarkSensorFilterType::Label --> sensor_filters.StringFilter
    OrientedLandmarkSensor *-- OrientedLandmarkSensorFilterType

    enum RobotSensorFilterType {
        Range(RangeFilter)
        Id(StringFilter)
        Label(StringFilter)
        Python(PythonFilter)
        Plugin(PluginFilter)
    }
    RobotSensorFilterType::Range --> sensor_filters.RangeFilter
    RobotSensorFilterType::Python --> sensor_filters.PythonFilter
    RobotSensorFilterType::Plugin --> sensor_filters.PluginFilter
    RobotSensorFilterType::Id --> sensor_filters.StringFilter
    RobotSensorFilterType::Label --> sensor_filters.StringFilter
    RobotSensor *-- RobotSensorFilterType

    enum ScanSensorFilterType {
        Range(RangeFilter)
        Python(PythonFilter)
        Plugin(PluginFilter)
    }
    ScanSensorFilterType::Range --> sensor_filters.RangeFilter
    ScanSensorFilterType::Python --> sensor_filters.PythonFilter
    ScanSensorFilterType::Plugin --> sensor_filters.PluginFilter
    ScanSensor *-- ScanSensorFilterType

    enum SpeedSensorFilterType {
        Range(RangeFilter)
        Python(PythonFilter)
        Plugin(PluginFilter)
    }
    SpeedSensorFilterType::Range --> sensor_filters.RangeFilter
    SpeedSensorFilterType::Python --> sensor_filters.PythonFilter
    SpeedSensorFilterType::Plugin --> sensor_filters.PluginFilter
    SpeedSensor *-- SpeedSensorFilterType

    
}


package networking {
    simulator.Simulator *-- NetworkManager
    class NetworkManager {
        broker
        process_messages()
    }

    node.Node *--  Network
    class Network {
        range: f32
        reception_delay: f32
        broker: Broker
        make_channel(PathKey) -> PathKey
        subscribe_to(keys: [PathKey], multiclient: Option<MultiClient>) -> MultiClient
        send_to(key: PathKey, message: Envelope, time: f32)
    }


    NetworkManager *-- .simusa_com.Broker
    Network -- .simusa_com.Broker
    Network -- .simusa_com.MultiClient
    Network -- Envelope


    class Envelope {
        from: String
        message: MessageTypes
        timestamp: f32
        message_flags: [MessageFlag]
    }

    enum MessageTypes {
        {field} String(String)
        {field} GoTo(GoToMessage)
        {field} SensorTrigger(SensorTriggerMessage)
        {field} Observation([Observation])
        {field} Event(EventRecord)
        {field} Custom([u8])
    }

    Envelope -- MessageTypes

    enum MessageFlag {
        God
        Unsubscribe
        Kill
    }
    Envelope -- "*" MessageFlag

}


package simusa_com as "simusa-com" {
    class Broker
    class MultiClient
}

package scenario {
    class Scenario
    Scenario *-- "*" Event
    class Event {
        triggering_nodes: [Regex]
        trigger: EventTriggerConfig
        event_type: EventTypeConfig
    }
    Event *-- EventTriggerConfig
    Event *-- EventTypeConfig

    enum EventTriggerConfig {
        Time(TimeEventTriggerConfig)
        Proximity(ProximityEventTriggerConfig)
        Area(AreaEventTriggerConfig)
    }
    EventTriggerConfig::Time --> TimeEventTriggerConfig
    EventTriggerConfig::Proximity --> ProximityEventTriggerConfig
    EventTriggerConfig::Area --> AreaEventTriggerConfig

    class TimeEventTriggerConfig {
        time
        occurences
    }

    enum AreaEventTriggerConfig {
        Rect(RectAreaEventTriggerConfig)
        Circle(CircleAreaEventTriggerConfig)
    }
    AreaEventTriggerConfig::Rect --> RectAreaEventTriggerConfig
    AreaEventTriggerConfig::Circle --> CircleAreaEventTriggerConfig

    class RectAreaEventTriggerConfig {
        bottom_left: (f32, f32)
        top_right: (f32, f32)
        inside: bool
    }

    class CircleAreaEventTriggerConfig {
        center: (f32, f32)
        radius: f32
        inside: bool
    }

    class ProximityEventTriggerConfig {
        protected_target: Option<String>
        distance: f32
        inside: bool
    }

    enum EventTypeConfig {
        Spawn(SpawnEventConfig)
        Kill(String)
    }
    EventTypeConfig::Spawn --> SpawnEventConfig

    class SpawnEventConfig {
        model_name: String
        node_name: String
    }

    .simulator.Simulator *-- Scenario
}

package gui {
    interface Drawable {
        add_record(time: f32, record: RecordType)
        draw(ui, viewport, painter_info, scale: f32, time: f32) -> ([Shape], (f32, f32))
        react(ui, ctx, response, painter_info, scale: f32, time: f32)
    }
}

interface PluginAPI {
    get_state_estimator(custom_config) -> StateEstimator
    get_navigator(custom_config) -> Navigator
    get_controller(custom_config) -> Controller
    get_physics(custom_config) -> Physics
    get_sensor(custom_config) -> Sensor
    get_sensor_filter(custom_config) -> SensorFilter
    get_sensor_fault(custom_config) -> FaultModel
    get_drawable(custom_config) -> Drawable
}
StateEstimator -- PluginAPI
Navigator -- PluginAPI
Controller -- PluginAPI
Physics -- PluginAPI
Sensor -- PluginAPI
SensorFilter -- PluginAPI
FaultModel -- PluginAPI
Drawable -- PluginAPI


@enduml

